{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@10.33.4",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:local": "pnpm db:up && vite dev",
		"db:up": "docker compose -f ../compose.yaml up db -d --wait",
		"db:down": "docker compose -f ../compose.yaml stop db",
		"db:reset": "docker compose -f ../compose.yaml down -v db && pnpm db:up",
		"db:logs": "docker compose -f ../compose.yaml logs -f db",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"migrate": "node scripts/migrate.ts",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"verify": "pnpm lint && pnpm check && pnpm test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@types/pg": "^8.20.0",
		"echarts": "^6.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"pg": "^8.22.0"
	}
}
